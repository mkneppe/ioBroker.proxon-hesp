{
  "name": "iobroker.proxon-hesp",
  "version": "0.6.1",
  "description": "Reads (and optionally writes) the HESP bus of Proxon ventilation/heat-pump units via an RS485-to-TCP gateway",
  "author": {
    "name": "Martin",
    "email": "mkspam@kneppe.org"
  },
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "proxon",
    "hesp",
    "ventilation",
    "lüftung",
    "heat pump",
    "rs485"
  ],
  "main": "build/src/main.js",
  "files": [
    "admin/",
    "build/src/",
    "io-package.json",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "README.de.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.2",
    "@iobroker/types": "^7.2.5",
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:js": "npm run build && node --test build/test/*.test.js",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script",
    "gen": "node tools/gen-io-package.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkneppe/ioBroker.proxon-hesp.git"
  },
  "homepage": "https://github.com/mkneppe/ioBroker.proxon-hesp",
  "bugs": {
    "url": "https://github.com/mkneppe/ioBroker.proxon-hesp/issues"
  }
}
