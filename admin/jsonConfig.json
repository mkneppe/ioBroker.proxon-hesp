{
    "i18n": true,
    "type": "tabs",
    "items": {
        "tabConnection": {
            "type": "panel",
            "label": "Connection",
            "items": {
                "hdrInfo": {
                    "type": "staticText",
                    "text": "The adapter listens to the HESP bus (19200 baud, 8N1). It only sends when enabled under \"Control\" (room setpoints, heater, clock, periodic parameter polling) or when the button Parameter_lesen is pressed. Data source: an RS485-to-TCP gateway that forwards the bytes transparently (the adapter connects to it, or the gateway connects to the adapter), or an RS485 interface directly on this computer (e.g. a USB-RS485 adapter).",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "connType": {
                    "type": "select",
                    "label": "Data source",
                    "options": [
                        {
                            "label": "TCP client: adapter connects to the gateway",
                            "value": "tcp"
                        },
                        {
                            "label": "TCP server: gateway connects to the adapter",
                            "value": "tcpserver"
                        },
                        {
                            "label": "Serial interface (e.g. USB-RS485)",
                            "value": "serial"
                        }
                    ],
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "host": {
                    "type": "text",
                    "label": "Gateway (IP or host name)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 8,
                    "md": 6,
                    "lg": 4,
                    "xl": 4,
                    "hidden": "data.connType !== 'tcp' && !!data.connType"
                },
                "bind": {
                    "type": "text",
                    "label": "Listen address (empty = all)",
                    "hidden": "data.connType !== 'tcpserver'",
                    "newLine": true,
                    "xs": 12,
                    "sm": 8,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "port": {
                    "type": "number",
                    "label": "TCP port",
                    "min": 1,
                    "max": 65535,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2,
                    "hidden": "data.connType === 'serial'"
                },
                "serialPath": {
                    "type": "autocompleteSendTo",
                    "label": "Serial port",
                    "command": "listSerial",
                    "freeSolo": true,
                    "hidden": "data.connType !== 'serial'",
                    "help": "e.g. /dev/ttyUSB0 or /dev/serial/by-id/... (stable name), COM3 on Windows. The list shows the ports found while the instance is running.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 8,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "serialBaud": {
                    "type": "select",
                    "label": "Baud rate",
                    "options": [
                        {
                            "label": "9600",
                            "value": 9600
                        },
                        {
                            "label": "19200",
                            "value": 19200
                        },
                        {
                            "label": "38400",
                            "value": 38400
                        },
                        {
                            "label": "57600",
                            "value": 57600
                        },
                        {
                            "label": "115200",
                            "value": 115200
                        }
                    ],
                    "hidden": "data.connType !== 'serial'",
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                },
                "serialDataBits": {
                    "type": "select",
                    "label": "Data bits",
                    "options": [
                        {
                            "label": "7",
                            "value": 7
                        },
                        {
                            "label": "8",
                            "value": 8
                        }
                    ],
                    "hidden": "data.connType !== 'serial'",
                    "newLine": true,
                    "xs": 12,
                    "sm": 4,
                    "md": 2,
                    "lg": 2,
                    "xl": 2
                },
                "serialParity": {
                    "type": "select",
                    "label": "Parity",
                    "options": [
                        {
                            "label": "none",
                            "value": "none"
                        },
                        {
                            "label": "even",
                            "value": "even"
                        },
                        {
                            "label": "odd",
                            "value": "odd"
                        }
                    ],
                    "hidden": "data.connType !== 'serial'",
                    "xs": 12,
                    "sm": 4,
                    "md": 2,
                    "lg": 2,
                    "xl": 2
                },
                "serialStopBits": {
                    "type": "select",
                    "label": "Stop bits",
                    "options": [
                        {
                            "label": "1",
                            "value": 1
                        },
                        {
                            "label": "2",
                            "value": 2
                        }
                    ],
                    "hidden": "data.connType !== 'serial'",
                    "xs": 12,
                    "sm": 4,
                    "md": 2,
                    "lg": 2,
                    "xl": 2
                },
                "watchdogSec": {
                    "type": "number",
                    "label": "Reconnect if no valid frames for (s)",
                    "min": 30,
                    "max": 3600,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "tabModules": {
            "type": "panel",
            "label": "Modules",
            "items": {
                "hdrModules": {
                    "type": "staticText",
                    "text": "Bus address -> folder name. Unknown addresses appear as Modul_<address>.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "modules": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6,
                    "items": [
                        {
                            "type": "number",
                            "attr": "address",
                            "title": "Bus address",
                            "width": "30%",
                            "min": 0,
                            "max": 1023
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name (folder)",
                            "width": "70%"
                        }
                    ]
                }
            }
        },
        "tabMappings": {
            "type": "panel",
            "label": "Mappings",
            "items": {
                "hdrMappings": {
                    "type": "staticText",
                    "text": "Each row creates a named state <module>.<name>. Kind R = response of the module, W = value the central control unit writes to the module. Index counts elements of the selected type. Empty bit = whole value. The default rows come from own captures and the projects markusmauch/proxon-hesp and DNier/proxon-hesp-homeassistant.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "mappings": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "number",
                            "attr": "module",
                            "title": "Module",
                            "width": "6%",
                            "min": 0,
                            "max": 1023
                        },
                        {
                            "type": "select",
                            "attr": "kind",
                            "title": "Kind",
                            "width": "5%",
                            "options": [
                                {
                                    "label": "R",
                                    "value": "R"
                                },
                                {
                                    "label": "W",
                                    "value": "W"
                                }
                            ]
                        },
                        {
                            "type": "number",
                            "attr": "register",
                            "title": "Register (dec.)",
                            "width": "7%",
                            "min": 0
                        },
                        {
                            "type": "number",
                            "attr": "index",
                            "title": "Index",
                            "width": "5%",
                            "min": 0
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name",
                            "width": "20%"
                        },
                        {
                            "type": "select",
                            "attr": "type",
                            "title": "Type",
                            "width": "9%",
                            "options": [
                                {
                                    "label": "auto",
                                    "value": "auto"
                                },
                                {
                                    "label": "float32",
                                    "value": "float32"
                                },
                                {
                                    "label": "int32",
                                    "value": "int32"
                                },
                                {
                                    "label": "uint32",
                                    "value": "uint32"
                                },
                                {
                                    "label": "int16",
                                    "value": "int16"
                                },
                                {
                                    "label": "uint16",
                                    "value": "uint16"
                                },
                                {
                                    "label": "uint8",
                                    "value": "uint8"
                                },
                                {
                                    "label": "Text",
                                    "value": "text"
                                },
                                {
                                    "label": "Date/time (0x032E)",
                                    "value": "calendar"
                                },
                                {
                                    "label": "Time (0x0330)",
                                    "value": "clock"
                                },
                                {
                                    "label": "Fan level (0x0208)",
                                    "value": "fanlevel"
                                }
                            ]
                        },
                        {
                            "type": "number",
                            "attr": "factor",
                            "title": "Factor",
                            "width": "6%"
                        },
                        {
                            "type": "text",
                            "attr": "unit",
                            "title": "Unit",
                            "width": "6%"
                        },
                        {
                            "type": "text",
                            "attr": "bit",
                            "title": "Bit",
                            "width": "4%"
                        },
                        {
                            "type": "text",
                            "attr": "ignore",
                            "title": "Ignore (raw)",
                            "width": "7%"
                        },
                        {
                            "type": "text",
                            "attr": "min",
                            "title": "Min",
                            "width": "5%"
                        },
                        {
                            "type": "text",
                            "attr": "max",
                            "title": "Max",
                            "width": "5%"
                        },
                        {
                            "type": "text",
                            "attr": "states",
                            "title": "Value texts (0:Off;1:On)",
                            "width": "10%"
                        },
                        {
                            "type": "checkbox",
                            "attr": "history",
                            "title": "History",
                            "width": "5%"
                        }
                    ]
                }
            }
        },
        "tabAdvanced": {
            "type": "panel",
            "label": "Advanced",
            "items": {
                "storeRegisters": {
                    "type": "checkbox",
                    "label": "Also store all registers under <module>.Register (auto-decoded + raw data)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "refreshSec": {
                    "type": "number",
                    "label": "Rewrite unchanged values at the latest after (s)",
                    "min": 10,
                    "max": 86400,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "historyInstance": {
                    "type": "instance",
                    "adapter": "_dataSources",
                    "label": "History instance for mappings with \"History\" checked",
                    "allowDeactivate": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "captureMinutes": {
                    "type": "number",
                    "label": "Duration of a capture (info.capture) in minutes",
                    "min": 1,
                    "max": 1440,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "eventLimit": {
                    "type": "number",
                    "label": "Number of stored events (info.events)",
                    "min": 10,
                    "max": 1000,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "learnLog": {
                    "type": "checkbox",
                    "label": "Learning log: every value change and unrecognised bytes in daily files (iobroker-data/proxon-hesp.N/lernen/)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "learnLogDays": {
                    "type": "number",
                    "label": "Retention in days (0 = unlimited)",
                    "min": 0,
                    "max": 3650,
                    "hidden": "!data.learnLog",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "tabControl": {
            "type": "panel",
            "label": "Control",
            "items": {
                "hdrControl": {
                    "type": "staticText",
                    "text": "By default the adapter only listens. If writing is allowed, a state <room>.Sollwert is created for each room module. It is rounded to the step; most room modules only accept whole degrees (20.5 °C was ignored in a test). A written value is sent as SET 0x01FB to the room module 2 s after the last change, in a quiet gap of the bus cycle (up to 10 tries), and acknowledged (ack) only after the module reports it back. This matches the behaviour of the central control unit.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "allowWrite": {
                    "type": "checkbox",
                    "label": "Allow writing room setpoints",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "controlModules": {
                    "type": "text",
                    "label": "Bus addresses of the room modules (comma-separated)",
                    "newLine": true,
                    "hidden": "!data.allowWrite",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "writeMin": {
                    "type": "number",
                    "label": "Minimum setpoint (°C)",
                    "min": 5,
                    "max": 30,
                    "hidden": "!data.allowWrite",
                    "xs": 12,
                    "sm": 3,
                    "md": 2,
                    "lg": 2,
                    "xl": 2
                },
                "writeMax": {
                    "type": "number",
                    "label": "Maximum setpoint (°C)",
                    "min": 10,
                    "max": 35,
                    "hidden": "!data.allowWrite",
                    "xs": 12,
                    "sm": 3,
                    "md": 2,
                    "lg": 2,
                    "xl": 2
                },
                "writeStep": {
                    "type": "select",
                    "label": "Step",
                    "options": [
                        {
                            "label": "1 °C (usual room modules)",
                            "value": 1
                        },
                        {
                            "label": "0.5 °C",
                            "value": 0.5
                        }
                    ],
                    "hidden": "!data.allowWrite",
                    "xs": 12,
                    "sm": 3,
                    "md": 2,
                    "lg": 2,
                    "xl": 2
                },
                "allowHeaterWrite": {
                    "type": "checkbox",
                    "label": "Allow enabling/locking the room heater (SET 0x0196)",
                    "help": "Creates <room>.Heizelement_freigeben. The central control unit (BDE) is not informed and may show the old state.",
                    "newLine": true,
                    "hidden": "!data.allowWrite",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "allowClockWrite": {
                    "type": "checkbox",
                    "label": "Allow setting the clock of the ventilation unit",
                    "help": "SET 0x032E to the ventilation unit; the central control unit (BDE) takes the time from there. Save after enabling.",
                    "newLine": true,
                    "hidden": "!data.allowWrite",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "clockSet": {
                    "type": "sendTo",
                    "label": "Set clock now",
                    "command": "setClock",
                    "jsonData": "{\"offset\": \"${data.clockOffsetMin}\"}",
                    "useNative": true,
                    "showProcess": true,
                    "newLine": true,
                    "hidden": "!data.allowWrite || !data.allowClockWrite",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "clockOffsetMin": {
                    "type": "number",
                    "label": "Clock offset (minutes)",
                    "help": "Time = system time + offset, e.g. 5 = the clock runs 5 min fast; also used by the state Zentrale.Geraet.Uhr_stellen (save for that)",
                    "min": -1440,
                    "max": 1440,
                    "step": 1,
                    "newLine": true,
                    "hidden": "!data.allowWrite || !data.allowClockWrite",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "hdrParams": {
                    "type": "header",
                    "text": "Parameters of the ventilation unit",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "txtParams": {
                    "type": "staticText",
                    "text": "The button \"Parameter_lesen\" (directly under the instance) queries each module in turn: name (meta 0x0001), directory (meta 0x0033/0x0034/0x0038/0x0039) and then every parameter. The values are stored under <module>.Parameter, the self-description under <module>.Meta. Only read queries are sent, one per bus gap (about every 12 s), so a complete run takes more than an hour. Parameter_lesen_aktiv, _Fortschritt and _Status show the progress. Periodic polling only affects the ventilation unit: the DPs given below (empty = all from its directory, requires one complete read first).",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "pollEnabled": {
                    "type": "checkbox",
                    "label": "Poll parameters periodically",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "pollMinutes": {
                    "type": "number",
                    "label": "Interval (minutes)",
                    "min": 5,
                    "max": 1440,
                    "hidden": "!data.pollEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 3,
                    "md": 2,
                    "lg": 2,
                    "xl": 2
                },
                "pollList": {
                    "type": "text",
                    "label": "DPs (e.g. 0x015F, 0x0228; empty = all)",
                    "hidden": "!data.pollEnabled",
                    "xs": 12,
                    "sm": 9,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                }
            }
        }
    }
}
